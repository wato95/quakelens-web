# Browser-visible URL for one immutable PF1-208 preview manifest.
# Run `npm run data:sync -- ../pulse-foundry` to create .env.local automatically.
VITE_QUAKELENS_MANIFEST_URL=./_preview/builds/<preview_build_id>/manifest.json

# Optional browser-visible MapLibre style URL. Defaults to OpenFreeMap Dark.
VITE_QUAKELENS_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
